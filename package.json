{
  "name": "cleanedin-extension",
  "version": "0.1.6",
  "description": "Manifest V3 extension to declutter LinkedIn feed posts with category, identity, keyword, and age filters.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "CleanedIn Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/yasingedik/cleanedin.git"
  },
  "bugs": {
    "url": "https://github.com/yasingedik/cleanedin/issues"
  },
  "homepage": "https://github.com/yasingedik/cleanedin",
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "edge-extension",
    "linkedin",
    "feed-filter"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:fixtures": "vitest run tests/fixtures",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "version": "node scripts/sync-manifest-version.mjs && git add manifest.json",
    "release": "npm version",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/chrome": "^0.0.306",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.8"
  }
}
